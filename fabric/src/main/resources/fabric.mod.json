{
	"schemaVersion": 1,
	"id": "avp_predator",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"accessWidener": "avp_predator.accesswidener",
	"authors": [],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/avp",
		"sources": "https://github.com/AliensVsPredator/AliensVsPredator"
	},
	"license": "${mod_license}",
	"icon": "${mod_icon}",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.predator.fabric.PredatorFabric"
		],
		"client": [
			"com.predator.fabric.client.PredatorFabricClient"
		],
		"fabric-datagen": [
			"com.predator.fabric.data.PredatorDataGenerator"
		],
		"rei_client": [],
		"jei_mod_plugin": []
	},
	"mixins": [
		"${mod_id}.mixins.json",
		"${mod_id}.fabric.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*",
		"blib": "~${blib_version}"
	},
	"suggests": {
		"avp_alien": "~${avp_alien_version}",
		"avp_human": "~${avp_human_version}"
	}
}
